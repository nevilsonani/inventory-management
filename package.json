  "private": true,
  "description": "Inventory management for distributors: sales, purchases, stock across godowns and reports. Next.js + Tailwind.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
